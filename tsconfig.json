{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"baseUrl": ".",
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleDetection": "force",

		"moduleResolution": "bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noPropertyAccessFromIndexSignature": false,
		"noUncheckedIndexedAccess": true,

		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"paths": {
			"@wha.ts/binary": ["packages/binary/src/index.ts"],
			"@wha.ts/binary/*": ["packages/binary/src/*"],
			"@wha.ts/core": ["packages/core/src/index.ts"],
			"@wha.ts/core/*": ["packages/core/src/*"],
			"@wha.ts/proto": ["packages/proto/src/index.ts"],
			"@wha.ts/proto/*": ["packages/proto/src/*"],
			"@wha.ts/signal": ["packages/signal/src/index.ts"],
			"@wha.ts/signal/*": ["packages/signal/src/*"],
			"@wha.ts/storage": ["packages/storage/src/index.ts"],
			"@wha.ts/storage/*": ["packages/storage/src/*"],
			"@wha.ts/types": ["packages/types/src/index.ts"],
			"@wha.ts/types/*": ["packages/types/src/*"],
			"@wha.ts/utils": ["packages/utils/src/index.ts"],
			"@wha.ts/utils/*": ["packages/utils/src/*"]
		},
		"skipLibCheck": true,

		"strict": true,
		"target": "ESNext",
		"verbatimModuleSyntax": true
	},
	"exclude": [
		"node_modules",
		"**/dist",
		"**/example-storage",
		"**/extension-storage"
	],
	"include": ["packages/**/*.ts", "packages/**/*.tsx", "packages/**/*.json"]
}
