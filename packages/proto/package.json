{
	"author": "João Lucas de Oliveira Lopes (jlucaso1)",
	"dependencies": {
		"@bufbuild/protobuf": "^2.10.1"
	},
	"description": "Protobuf definitions for WhatsApp communication",
	"devDependencies": {
		"@bufbuild/buf": "^1.61.0",
		"@bufbuild/protoc-gen-es": "^2.10.1",
		"acorn": "^8.15.0",
		"acorn-walk": "^8.3.4"
	},
	"exports": {
		".": {
			"development": "./src/index.ts",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"whatsapp",
		"typescript",
		"api",
		"protobuf"
	],
	"license": "MIT",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"name": "@wha.ts/proto",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jlucaso1/wha.ts.git"
	},
	"scripts": {
		"build": "tsup src/index.ts --format=esm --dts",
		"proto:fetch": "bun ./scripts/fetch-proto.ts",
		"proto:gen": "buf generate"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "0.1.1"
}
